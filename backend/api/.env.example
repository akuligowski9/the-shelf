# Backend Environment Variables
# Copy this to .env for local development

PORT=3001
DATABASE_URL=postgres://shelf:shelf@localhost:5432/shelf
DEMO_MODE=false
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

