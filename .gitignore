############################
# Personal data & logs
############################

# Daily JSON logs (personal, local-first)
data/logs/*.json
data/daily/

# Nightly backups - tracked for auto-restore on dev start
# (committed by GitHub Actions nightly backup workflow)
!data/backups/*.json
!data/backups/.gitkeep

# Dev restore tracking file
backend/api/.last-restore

# Keep demo logs for demo-seed script
# (only the demo/ subdirectory is tracked)

# Keep documentation about data
!data/README.md

############################
# Backend (Node API)
############################

backend/api/node_modules/
backend/api/.env

############################
# Frontend — iOS (SwiftUI)
############################

# Xcode build artifacts
frontend/ios/DerivedData/
frontend/ios/build/

# User-specific Xcode files
frontend/ios/*.xcodeproj/xcuserdata/
frontend/ios/*.xcworkspace/xcuserdata/

############################
# Frontend — Web (React)
############################

frontend/web/node_modules/
frontend/web/.env
frontend/web/dist/
frontend/web/build/

############################
# OS / Editor noise
############################

.DS_Store
.idea/
.vscode/
